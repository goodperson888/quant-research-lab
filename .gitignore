.DS_Store
.env
.venv/
.tools/
.cache/
.bootstrap-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.playwright-mcp/
.coverage
htmlcov/

# Local product runtime
runtime/app/*.sqlite3
runtime/app/*.sqlite3-*
runtime/app/*.db
runtime/app/*.db-*
runtime/app/logs/

# Next.js / Node local state
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*
!apps/web/.env.example
apps/web/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Large or generated market data
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/**/.gitkeep
!data/README.md

# Local analytical catalogs are reproducible query/state layers
data/catalog/*.duckdb
data/catalog/*.duckdb.*
data/catalog/*.wal
data/catalog/*.tmp
data/catalog/*.db
data/catalog/*.sqlite*
!data/catalog/.gitkeep
!data/catalog/README.md

# Generated runs and reports
experiments/runs/**
!experiments/runs/.gitkeep
reports/daily/**
reports/weekly/**
reports/backtests/**
reports/correctness/**
reports/diagnostics/**
reports/risk/**
!reports/**/.gitkeep

# Runtime secrets/state
runtime/freqtrade/user_data/config.json
runtime/freqtrade/user_data/logs/**
runtime/freqtrade/user_data/tradev3.sqlite*
runtime/freqtrade/user_data/backtest_results/
runtime/freqtrade/user_data/data/

# Registry is local state; export snapshots before committing
factor_library/registry.sqlite3
