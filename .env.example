# Copy to .env only when needed. Never commit secrets.
QUANT_LAB_MODE=research
LIVE_TRADING_ENABLED=false

# Keep caches and managed runtimes inside this project.
UV_CACHE_DIR=.cache/uv
UV_PYTHON_INSTALL_DIR=.tools/python
UV_TOOL_DIR=.tools/uv-tools
UV_PROJECT_ENVIRONMENT=.venv
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
XDG_CACHE_HOME=.cache
PYTHONPYCACHEPREFIX=.cache/pycache
MPLCONFIGDIR=.cache/matplotlib

# Exchange credentials are intentionally absent.
# Use environment variables or an external secret manager for dry-run/live stages.
