<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quantlab.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/laochen/Documents/lianghua/quant-research-lab/scripts/run_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/laochen/Documents/lianghua/quant-research-lab/reports/daily/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/laochen/Documents/lianghua/quant-research-lab/reports/daily/launchd.err.log</string>
</dict>
</plist>
